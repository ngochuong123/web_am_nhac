<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Quản lý Bài hát | Diệu Âm Tiên Cảnh</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .admin-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .btn-add {
            background: var(--accent-cyan);
            color: #000;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .song-table {
            width: 100%;
            border-collapse: collapse;
            background: var(--card-bg);
            border-radius: 10px;
            overflow: hidden;
        }

        .song-table th,
        .song-table td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .song-table th {
            background: var(--sidebar-bg);
            font-weight: bold;
        }

        .song-actions {
            display: flex;
            gap: 10px;
        }

        .btn-edit,
        .btn-delete {
            padding: 5px 10px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.8rem;
        }

        .btn-edit {
            background: var(--accent-yellow);
            color: #000;
        }

        .btn-delete {
            background: #ff4444;
            color: #fff;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: var(--card-bg);
            padding: 30px;
            border-radius: 10px;
            width: 90%;
            max-width: 600px;
            max-height: 80vh;
            overflow-y: auto;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 5px;
            background: var(--bg-dark);
            color: var(--text-main);
        }

        .form-group textarea {
            height: 100px;
            resize: vertical;
        }

        .modal-actions {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
            margin-top: 20px;
        }

        .btn-save {
            background: var(--accent-cyan);
            color: #000;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
        }

        .btn-cancel {
            background: transparent;
            color: var(--text-main);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }

        /* Toast Notification */
        .toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 2000;
        }

        .toast {
            background: var(--card-bg);
            color: var(--text-main);
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 10px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border-left: 4px solid var(--accent-cyan);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 250px;
            animation: slideIn 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            backdrop-filter: blur(10px);
        }

        .toast.success { border-left-color: #00ff88; }
        .toast.error { border-left-color: #ff4444; }

        @keyframes slideIn {
            from { transform: translateX(100%); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }

        .toast-icon {
            font-size: 1.2rem;
        }

        .toast.success .toast-icon { color: #00ff88; }
        .toast.error .toast-icon { color: #ff4444; }

        /* Loading Spinner */
        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(0, 0, 0, 0.1);
            border-top: 2px solid #000;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            display: none;
            margin-right: 8px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .btn-save.loading .spinner {
            display: inline-block;
        }

        .btn-save.loading span {
            display: none;
        }

        .btn-save:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- Toast Container -->
        <div id="toastContainer" class="toast-container"></div>

        <!-- SIDEBAR -->
        <%- include('partials/sidebar') %>

            <main class="main-content">
                <!-- HEADER -->
                <%- include('partials/header') %>

                    <div class="admin-container">
                        <div class="admin-header">
                            <h1 data-lang="admin_title">Quản lý Bài hát</h1>
                            <button class="btn-add" onclick="openAddModal()">
                                <i class="fas fa-plus"></i> <span data-lang="add_song">Thêm bài hát</span>
                            </button>
                        </div>

                        <table class="song-table">
                            <thead>
                                <tr>
                                    <th data-lang="id_col">ID</th>
                                    <th data-lang="title_col">Tiêu đề</th>
                                    <th data-lang="artist_col">Nghệ sĩ</th>
                                    <th data-lang="genre_col">Thể loại</th>
                                    <th data-lang="continent_col">Châu lục</th>
                                    <th data-lang="plays_col">Lượt nghe</th>
                                    <th data-lang="actions_col">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="songTableBody">
                                <% songs.forEach(song=> { %>
                                    <tr data-id="<%= song.id %>">
                                        <td>
                                            <%= song.id %>
                                        </td>
                                        <td>
                                            <%= song.title %>
                                        </td>
                                        <td>
                                            <%= song.artist %>
                                        </td>
                                        <td>
                                            <%= song.genre %>
                                        </td>
                                        <td>
                                            <%= song.continent %>
                                        </td>
                                        <td>
                                            <%= song.play_count.toLocaleString() %>
                                        </td>
                                        <td class="song-actions">
                                            <button class="btn-edit" onclick="openEditModal(<%= song.id %>)">
                                                <i class="fas fa-edit"></i> <span data-lang="edit_btn">Sửa</span>
                                            </button>
                                            <button class="btn-delete" onclick="deleteSong(<%= song.id %>)">
                                                <i class="fas fa-trash"></i> <span data-lang="delete_btn">Xóa</span>
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); %>
                            </tbody>
                        </table>
                    </div>
            </main>
    </div>

    <!-- Modal thêm/sửa bài hát -->
    <div id="songModal" class="modal">
        <div class="modal-content">
            <h2 id="modalTitle" data-lang="add_new_title">Thêm bài hát mới</h2>
            <form id="songForm">
                <input type="hidden" id="songId" name="id">

                <div class="form-group">
                    <label for="title" data-lang="title_label">Tiêu đề:</label>
                    <input type="text" id="title" name="title" required>
                </div>

                <div class="form-group">
                    <label for="artist" data-lang="artist_label">Nghệ sĩ:</label>
                    <input type="text" id="artist" name="artist" required>
                </div>

                <div class="form-group">
                    <label for="duration" data-lang="duration_label">Thời lượng (vd: 3:45):</label>
                    <input type="text" id="duration" name="duration" placeholder="3:45" required>
                </div>

                <div class="form-group">
                    <label for="genre" data-lang="genre_label">Thể loại:</label>
                    <input type="text" id="genre" name="genre" required>
                </div>

                <div class="form-group">
                    <label for="continent" data-lang="continent_label">Châu lục:</label>
                    <select id="continent" name="continent" required>
                        <option value="asia" data-lang="asia_name">Châu Á</option>
                        <option value="europe" data-lang="europe_name">Châu Âu</option>
                        <option value="america" data-lang="america_name">Châu Mỹ</option>
                        <option value="africa" data-lang="africa_name">Châu Phi</option>
                        <option value="oceania" data-lang="oceania_name">Châu Đại Dương</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="cover_url" data-lang="cover_url_label">URL ảnh bìa:</label>
                    <input type="url" id="cover_url" name="cover_url" placeholder="https://...">
                </div>

                <div class="form-group">
                    <label for="audio_url" data-lang="audio_url_label">URL file nhạc:</label>
                    <input type="url" id="audio_url" name="audio_url" placeholder="https://...">
                    <small style="color: var(--text-secondary); font-size: 0.8rem;" data-lang="or_upload_label">Hoặc upload file:</small>
                    <input type="file" id="audio_file" name="audioFile" accept="audio/*">
                </div>

                <div class="form-group">
                    <label for="play_count" data-lang="play_count_label">Lượt nghe:</label>
                    <input type="number" id="play_count" name="play_count" value="0" min="0">
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-cancel" onclick="closeModal()" data-lang="cancel_btn">Hủy</button>
                    <button type="submit" class="btn-save" id="btnSave">
                        <div class="spinner"></div>
                        <span data-lang="save_btn">Lưu</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/lang.js"></script>
    <script>
        let currentSongId = null;

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';
            
            toast.innerHTML = `
                <i class="fas ${icon} toast-icon"></i>
                <span class="toast-message">${message}</span>
            `;
            
            container.appendChild(toast);
            
            // Tự động xóa toast sau 3 giây
            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateX(100%)';
                toast.style.transition = 'all 0.5s ease';
                setTimeout(() => toast.remove(), 500);
            }, 3000);
        }

        function openAddModal() {
            currentSongId = null;
            document.getElementById('modalTitle').textContent = typeof getTranslation === 'function' ? getTranslation('add_new_title') : 'Thêm bài hát mới';
            document.getElementById('songForm').reset();
            document.getElementById('songModal').style.display = 'flex';
        }

        function openEditModal(songId) {
            currentSongId = songId;
            document.getElementById('modalTitle').textContent = typeof getTranslation === 'function' ? getTranslation('edit_song_title') : 'Sửa bài hát';

            // Lấy dữ liệu bài hát từ table
            const row = document.querySelector(`tr[data-id="${songId}"]`);
            const cells = row.querySelectorAll('td');

            document.getElementById('songId').value = songId;
            document.getElementById('title').value = cells[1].textContent;
            document.getElementById('artist').value = cells[2].textContent;
            document.getElementById('genre').value = cells[3].textContent;
            document.getElementById('continent').value = cells[4].textContent;
            // Các field khác cần fetch từ API

            fetchSongDetails(songId);
            document.getElementById('songModal').style.display = 'flex';
        }

        async function fetchSongDetails(songId) {
            try {
                const response = await fetch(`/api/songs/${songId}`);
                if (!response.ok) throw new Error('Failed to fetch');
                const song = await response.json();

                document.getElementById('duration').value = song.duration;
                document.getElementById('cover_url').value = song.cover_url;
                document.getElementById('audio_url').value = song.audio_url;
                document.getElementById('play_count').value = song.play_count;
            } catch (err) {
                console.error('Lỗi lấy chi tiết bài hát:', err);
                showToast(typeof getTranslation === 'function' ? getTranslation('error_fetching') : 'Lỗi lấy chi tiết bài hát', 'error');
            }
        }

        function closeModal() {
            document.getElementById('songModal').style.display = 'none';
        }

        const songFormEl = document.getElementById('songForm');
        const btnSave = document.getElementById('btnSave');

        if (songFormEl) {
            songFormEl.addEventListener('submit', async (e) => {
                e.preventDefault();

                // Bật trạng thái loading
                btnSave.classList.add('loading');
                btnSave.disabled = true;

                const formData = new FormData(e.target);
                const songData = Object.fromEntries(formData);
                const audioFile = formData.get('audioFile');

                try {
                    let response;
                    const url = audioFile && audioFile.size > 0 ? '/api/upload-song' : '/api/songs';

                    if (currentSongId) {
                        // Update - tạm thời chỉ support URL
                        response = await fetch(`/api/songs/${currentSongId}`, {
                            method: 'PUT',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(songData)
                        });
                    } else {
                        // Create
                        if (audioFile && audioFile.size > 0) {
                            // Upload file
                            const uploadData = new FormData();
                            uploadData.append('title', songData.title);
                            uploadData.append('artist', songData.artist);
                            uploadData.append('duration', songData.duration);
                            uploadData.append('genre', songData.genre);
                            uploadData.append('continent', songData.continent);
                            uploadData.append('cover_url', songData.cover_url);
                            uploadData.append('audioFile', audioFile);

                            response = await fetch(url, {
                                method: 'POST',
                                body: uploadData
                            });
                        } else {
                            // URL
                            response = await fetch(url, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify(songData)
                            });
                        }
                    }

                    if (response.ok) {
                        const successMsg = typeof getTranslation === 'function' ? getTranslation('save_success') : 'Lưu bài hát thành công!';
                        showToast(successMsg, 'success');
                        
                        setTimeout(() => {
                            closeModal();
                            location.reload(); // Refresh page
                        }, 1000);
                    } else {
                        const error = await response.json();
                        const errorMsg = typeof getTranslation === 'function' ? getTranslation('error_saving') : 'Lỗi lưu bài hát';
                        showToast(errorMsg + ': ' + (error.message || ''), 'error');
                        btnSave.classList.remove('loading');
                        btnSave.disabled = false;
                    }
                } catch (err) {
                    console.error('Lỗi:', err);
                    const errorMsg = typeof getTranslation === 'function' ? getTranslation('error_saving') : 'Lỗi lưu bài hát';
                    showToast(errorMsg, 'error');
                    btnSave.classList.remove('loading');
                    btnSave.disabled = false;
                }
            });
        }

        async function deleteSong(songId) {
            const confirmMsg = typeof getTranslation === 'function' ? getTranslation('confirm_delete') : 'Bạn có chắc muốn xóa bài hát này?';
            if (!confirm(confirmMsg)) return;

            try {
                const response = await fetch(`/api/songs/${songId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    const successMsg = typeof getTranslation === 'function' ? getTranslation('delete_success') : 'Xóa bài hát thành công!';
                    showToast(successMsg, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    const errorMsg = typeof getTranslation === 'function' ? getTranslation('error_deleting') : 'Lỗi xóa bài hát';
                    showToast(errorMsg, 'error');
                }
            } catch (err) {
                console.error('Lỗi:', err);
                const errorMsg = typeof getTranslation === 'function' ? getTranslation('error_deleting') : 'Lỗi xóa bài hát';
                showToast(errorMsg, 'error');
            }
        }

        // Đóng modal khi click outside
        const songModalEl = document.getElementById('songModal');
        if (songModalEl) {
            songModalEl.addEventListener('click', (e) => {
                if (e.target.id === 'songModal') {
                    closeModal();
                }
            });
        }
    </script>
</body>

</html>