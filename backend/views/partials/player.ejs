<div class="music-player-bar" id="music-player-bar">
    <audio id="main-audio-player" preload="metadata"></audio>
    
    <div class="player-info">
        <div class="player-cover" id="player-cover"></div>
        <div class="player-details">
            <h4 id="player-title" data-lang="no_song">Chưa có bài hát</h4>
            <p id="player-artist">---</p>
        </div>
        <i class="fas fa-heart btn-favorite favorite-btn" id="player-favorite-btn"></i>
    </div>

    <div class="player-controls">
        <div class="control-buttons">
            <i class="fas fa-random btn-action"></i>
            <i class="fas fa-step-backward btn-action" id="btn-prev"></i>
            <div class="play-pause-btn" id="btn-play-pause">
                <i class="fas fa-play" id="icon-play-pause"></i>
            </div>
            <i class="fas fa-step-forward btn-action" id="btn-next"></i>
            <i class="fas fa-redo-alt btn-action"></i>
        </div>
        <div class="progress-container">
            <span id="current-time">0:00</span>
            <input type="range" id="progress-bar" value="0" min="0" max="100" step="1">
            <span id="total-time">0:00</span>
        </div>
    </div>

    <div class="player-extra">
        <i class="fas fa-volume-up" id="btn-mute"></i>
        <input type="range" id="volume-bar" value="100" min="0" max="100" step="1">
        <i class="fas fa-list-ul btn-action"></i>
    </div>
</div>

<div id="loading-overlay" class="loading-overlay">
    <div class="loading-content">
        <i class="fas fa-yin-yang fa-spin"></i>
        <p data-lang="logout_loading">Đang nghịch chuyển thời không, rời khỏi tiên cảnh...</p>
    </div>
</div>

<div id="transition-container" class="transition-container">
    <video id="transition-video" preload="auto" muted playsinline>
        <source src="/images/demo.mp4" type="video/mp4">
    </video>
    <div id="mist-swipe" class="mist-swipe"></div>
</div>
