<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Diệu Âm Tiên Cảnh - Giao diện nghe nhạc</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="container">
        <!-- SIDEBAR -->
        <%- include('partials/sidebar') %>

            <main class="main-content">
                <!-- HEADER -->
                <%- include('partials/header') %>

                    <section class="scroll-area">
                        <div class="hero-banner">
                            <div class="hero-overlay"></div>
                            <div class="hero-content">
                                <p class="hero-category" data-lang="hero_cat">ÂM NHẠC</p>
                                <h1 class="hero-title" data-lang="hero_title">KẾT NỐI THẾ GIỚI</h1>
                                <p class="hero-description" data-lang="hero_desc">
                                    Chiêm ngưỡng vũ trụ âm thanh với những giai điệu tiên cảnh,
                                    kết nối tâm hồn bạn với những bản nhạc tuyệt vời từ khắp thế giới
                                </p>
                                <a href="/explore" class="btn-play-now">
                                    <i class="fas fa-play"></i> <span data-lang="explore_now">Khám phá ngay</span>
                                </a>
                            </div>
                        </div>

                        <!-- GỢI Ý DÀNH CHO BẠN -->
                        <section class="music-section">
                            <div class="section-header">
                                <h2 data-lang="suggest_title">GỢI Ý DÀNH CHO BẠN</h2>
                                <span class="view-all" data-lang="view_all"
                                    onclick="window.location.href='/search?q='">Xem tất cả</span>
                            </div>
                            <div class="card-grid">
                                <% suggestedSongs.forEach(song=> { %>
                                    <div class="music-card" data-song-id="<%= song.id %>" data-title="<%= song.title %>"
                                        data-artist="<%= song.artist %>" data-cover="<%= song.cover_url %>"
                                        data-audio="<%= song.audio_url %>">
                                        <div class="card-img" style="background-image: url('<%= song.cover_url %>');">
                                            <div class="play-overlay">
                                                <i class="fas fa-heart action-icon"></i>
                                                <i class="fas fa-play play-icon"></i>
                                                <i class="fas fa-ellipsis-h action-icon"></i>
                                            </div>
                                            <i class="fas fa-heart favorite-btn card-favorite"
                                                data-id="<%= song.id %>"></i>
                                        </div>
                                        <h3>
                                            <%= song.title %>
                                        </h3>
                                        <p>
                                            <%= song.artist %>
                                        </p>
                                    </div>
                                    <% }); %>
                            </div>
                        </section>

                        <!-- GẦN ĐÂY CỦA BẠN -->
                        <section class="music-section">
                            <div class="section-header">
                                <h2 data-lang="recent_title">GẦN ĐÂY CỦA BẠN</h2>
                                <span class="view-all" data-lang="view_all"
                                    onclick="window.location.href='/history'">Xem tất cả</span>
                            </div>
                            <div class="card-grid">
                                <% recentSongs.forEach(song=> { %>
                                    <div class="music-card" data-song-id="<%= song.id %>" data-title="<%= song.title %>"
                                        data-artist="<%= song.artist %>" data-cover="<%= song.cover_url %>"
                                        data-audio="<%= song.audio_url %>">
                                        <div class="card-img" style="background-image: url('<%= song.cover_url %>');">
                                            <div class="play-overlay">
                                                <i class="fas fa-heart action-icon"></i>
                                                <i class="fas fa-play play-icon"></i>
                                                <i class="fas fa-ellipsis-h action-icon"></i>
                                            </div>
                                            <i class="fas fa-heart favorite-btn card-favorite"
                                                data-id="<%= song.id %>"></i>
                                        </div>
                                        <h3>
                                            <%= song.title %>
                                        </h3>
                                        <p>
                                            <%= song.artist %>
                                        </p>
                                    </div>
                                    <% }); %>
                            </div>
                        </section>
                    </section>
            </main>

            <aside class="right-panel">
                <div class="music-section">
                    <h2><i class="fas fa-chart-line"></i> <span data-lang="chart_title">KHÁM PHÁ ÂM NHẠC</span></h2>
                    <div class="rank-list">
                        <% chartSongs.forEach((song, index)=> { %>
                            <div class="rank-item" data-song-id="<%= song.id %>" data-title="<%= song.title %>"
                                data-artist="<%= song.artist %>" data-cover="<%= song.cover_url %>"
                                data-audio="<%= song.audio_url %>">
                                <span class="rank-num num-<%= index + 1 %>">
                                    <%= index + 1 %>
                                </span>
                                <div class="rank-img" style="background-image: url('<%= song.cover_url %>');"></div>
                                <div class="rank-info">
                                    <h4>
                                        <%= song.title %>
                                    </h4>
                                    <p>
                                        <%= song.artist %>
                                    </p>
                                </div>
                                <span class="rank-views">
                                    <% if (song.play_count >= 1000000) { %>
                                        <%= (song.play_count / 1000000).toFixed(1) %> <span data-lang="million">triệu</span>
                                    <% } else { %>
                                        <%= song.play_count.toLocaleString() %>
                                    <% } %>
                                </span>
                                <div class="play-btn-small">
                                    <i class="fas fa-play"></i>
                                </div>
                            </div>
                            <% }); %>
                    </div>
                </div>

                <div class="premium-box">
                    <h2 data-lang="premium_title">Gói Cao Cấp</h2>
                    <p data-lang="premium_desc">Trải nghiệm không giới hạn với chất lượng cao nhất</p>
                    <button class="btn-upgrade" data-lang="upgrade_now">Nâng cấp ngay</button>
                </div>
            </aside>
    </div>

    <!-- MUSIC PLAYER BAR -->
    <%- include('partials/player') %>

    <script>
        // Bọc trong nháy để VS Code không báo lỗi cú pháp HTML
        window.__USER__ = <%- JSON.stringify(user || null) %>;
    </script>
    <script src="/js/lang.js"></script>
    <script src="/js/script.js"></script>
</body>

</html>