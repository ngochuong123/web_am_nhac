<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tinh Không Khám Phá | Diệu Âm Tiên Cảnh</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/explore.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <div class="container">
        <!-- SIDEBAR -->
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <!-- HEADER -->
            <%- include('partials/header') %>

            <!-- EXPLORE AREA -->
            <section class="explore-area">
                <div class="world-map-container">
                    <h2 class="map-title" data-lang="map_header">ÂM LUẬT TỨ HẢI</h2>

                    <div class="map-wrapper">
                        <!-- Bản đồ nền -->
                        <img src="https://upload.wikimedia.org/wikipedia/commons/8/80/World_map_-_low_resolution.svg" class="world-map-img"
                            onerror="this.src='https://raw.githubusercontent.com/djaiss/mapsicon/master/world.svg'">

                        <!-- Các điểm mốc Châu Lục -->
                        <div class="continent-item america" onclick="selectContinent('america')">
                            <div class="continent-tag" data-lang="america_name">CHÂU MỸ</div>
                            <div class="pulse-point"></div>
                        </div>

                        <div class="continent-item europe" onclick="selectContinent('europe')">
                            <div class="continent-tag" data-lang="europe_name">CHÂU ÂU</div>
                            <div class="pulse-point"></div>
                        </div>

                        <div class="continent-item africa" onclick="selectContinent('africa')">
                            <div class="continent-tag" data-lang="africa_name">CHÂU PHI</div>
                            <div class="pulse-point"></div>
                        </div>

                        <div class="continent-item asia" onclick="selectContinent('asia')">
                            <div class="continent-tag" data-lang="asia_name">CHÂU Á</div>
                            <div class="pulse-point"></div>
                        </div>

                        <div class="continent-item oceania" onclick="selectContinent('oceania')">
                            <div class="continent-tag" data-lang="oceania_name">CHÂU ĐẠI DƯƠNG</div>
                            <div class="pulse-point"></div>
                        </div>
                    </div>
                </div>

                <div id="continent-songs-wrapper" style="display: none; padding: 20px;">
                    <h2 id="continent-songs-title" style="margin-bottom: 20px; color: var(--accent-cyan);">Danh sách bài hát</h2>
                    <div id="continent-songs-container" class="song-list-container">
                        <!-- Javascript sẽ đổ dữ liệu vào đây -->
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- MUSIC PLAYER BAR -->
    <%- include('partials/player') %>

    <!-- Truyền dữ liệu bài hát theo châu lục từ server -->
    <script>
        window.__USER__ = <%- JSON.stringify(user) %>;
        window.__SONGS_BY_CONTINENT__ = <%- JSON.stringify(songsByContinent) %>;
    </script>
    <script src="/js/lang.js"></script>
    <script src="/js/script.js"></script>
    <script src="/js/explore.js"></script>
</body>

</html>
