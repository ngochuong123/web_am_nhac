<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Linh Đài Nhập Cảnh | Diệu Âm Tiên Cảnh</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>

    <div class="xianxia-bg">
        <div class="mist"></div>
        <div class="qi-glow glow-1"></div>
        <div class="qi-glow glow-2"></div>
    </div>

    <div class="container">
        <div class="lang-switch"
            style="position: absolute; top: 20px; right: 20px; cursor: pointer; font-size: 0.9rem; color: #fff; z-index: 100;">
            <span onclick="changeLanguage('vi')" id="btn-vi">VN</span> |
            <span onclick="changeLanguage('en')" id="btn-en">EN</span>
        </div>

        <div class="register-card">
            <div class="card-header">
                <div class="sect-icon">
                    <i class="fa-solid fa-yin-yang"></i>
                </div>
                <h2 data-lang="login_header">LINH ĐÀI NHẬP CẢNH</h2>
                <p data-lang="login_sub">Xác nhận đạo tâm, tiếp tục hành trình tu luyện</p>
            </div>

            <% if (error) { %>
            <div class="error-msg" style="background: rgba(255,77,77,0.15); border: 1px solid rgba(255,77,77,0.3); color: #ff6b6b; padding: 10px 15px; border-radius: 10px; margin-bottom: 20px; font-size: 0.85rem;">
                <i class="fas fa-exclamation-triangle"></i> <%= error %>
            </div>
            <% } %>

            <form id="loginForm">
                <div class="input-box">
                    <i class="fa-solid fa-om"></i>
                    <input type="text" id="username" data-lang-placeholder="user_placeholder"
                        placeholder="Đạo hiệu hoặc Email" required>
                </div>

                <div class="input-box">
                    <i class="fa-solid fa-key"></i>
                    <input type="password" id="password" data-lang-placeholder="pass_placeholder"
                        placeholder="Mật pháp (Mật khẩu)" required>
                </div>

                <div class="forgot-link" style="text-align: right; margin: -15px 5px 25px 0;">
                    <a href="#" data-lang="forgot_pass"
                        style="font-size: 0.75rem; color: #889; text-decoration: none;">Thất lạc mật pháp?</a>
                </div>

                <button type="submit" class="btn-ascend">
                    <span data-lang="login_btn">VẬN KHÍ NHẬP CẢNH</span>
                </button>
            </form>

            <div class="card-footer">
                <span data-lang="no_account">Chưa có linh căn?</span> <a href="/register" data-lang="go_reg">Khai mở
                    ngay</a>
            </div>
        </div>
    </div>

    <script src="/js/lang.js"></script>
    <script src="/js/login.js"></script>
</body>

</html>
